PACKAGE = LilyTerm
BINARY = lilyterm
VERSION = 0.13.0

# The original author; this modernized fork is maintained at MAINSITE
AUTHOR = Lu, Chao-Ming (Tetralet)
BUGREPORT = https://github.com/ebal/LilyTerm/issues
MAINSITE = https://github.com/ebal/LilyTerm
ISSUES = https://github.com/ebal/LilyTerm/issues

LANG_LIST = de fr es it nl pl pt_BR ru sk tr uk zh_CN zh_TW

YEAR = $(shell date +%Y)
ECHO = $(firstword $(wildcard /usr/bin/echo /bin/echo) echo)
PRINTF = $(firstword $(wildcard /usr/bin/printf /bin/printf) printf)

PREFIX = /usr/local
ETCDIR = $(PREFIX)/etc/xdg
BINDIR = $(PREFIX)/bin
DATADIR = $(PREFIX)/share
MANDIR = $(DATADIR)/man/man1
DOCDIR = $(DATADIR)/doc/$(BINARY)
EXAMPLES_DIR = $(DATADIR)/doc/$(BINARY)/examples
LOCALEDIR = $(DATADIR)/locale
ICONDIR = $(DATADIR)/pixmaps
